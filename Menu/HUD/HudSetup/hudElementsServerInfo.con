hudBuilder.setPictureNodeTexture 	Ingame/Scoreboard/Icons/kickvote_yes.tga
hudBuilder.setNodeLogicShowVariable 	NOT ServerInfoSelected 1
hudBuilder.setNodeLogicShowVariable 	AND ServerIsFavourite 1

hudBuilder.createPictureNode 		ServerInfoLayer NotFavouriteServer 12 1 15 15
hudBuilder.setPictureNodeTexture 	Ingame/Scoreboard/Icons/kickvote_no.tga
hudBuilder.setNodeLogicShowVariable 	NOT ServerInfoSelected 1
hudBuilder.setNodeLogicShowVariable 	NOT ServerIsFavourite 1

