
hudBuilder.createSplitNode		Scoreboard ServerInfoLayer
hudBuilder.setNodeLogicShowVariable	NOT SinglePlayerActive 1

rem ------------------------- Dummy button making clicking outside the menu disabling the serverinfo ---------------

hudBuilder.createButtonNode 		ServerInfoLayer DummyButtonServerInfo 0 0 800 600
hudBuilder.setButtonNodeTexture 	2 Ingame/GeneralIcons/empty.tga
hudBuilder.setButtonNodeTexture 	1 Ingame/GeneralIcons/empty.tga
hudBuilder.setButtonNodeConCmd		"hudItems.setBool ServerInfoSelected 0" 0
hudBuilder.setButtonNodeConCmd		"hudItems.setBool ServerInfoSelected 0" 3
hudBuilder.setNodeShowVariable 		ServerInfoSelected

rem ----------------------------------------Bar and button----------------------------------------------------------

hudBuilder.createPictureNode 		ServerInfoLayer ServerInfoBar 10 0 310 18
hudBuilder.setNodeColor 		0.481 0.474 0.388 1
hudBuilder.setNodeLogicShowVariable 	NOT ServerInfoSelected 1

