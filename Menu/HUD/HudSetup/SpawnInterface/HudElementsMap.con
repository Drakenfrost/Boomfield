rem ----------------------------------- New layer for the Map -----------------------------------------------

hudBuilder.newLayer

rem --------------------------------------------Map----------------------------------------------------------

rem Needs this because the mapnode itself doesn't get any parent node created automaticly
hudBuilder.createSplitNode		IngameHud MapSplit
hudBuilder.setNodeShowVariable		MapShow
hudBuilder.setNodeInTime 		0.5
hudBuilder.setNodeOutTime 		0.5
hudBuilder.addNodeAlphaShowEffect	

hudBuilder.createMapNode		MapSplit Minimap

hudBuilder.setMaxiPos		-122/-273
hudBuilder.setMiniPos		197/-300
hudBuilder.setMaxiSize		512/512
hudBuilder.setMiniSize 		197/197
hudBuilder.setCommanderPos	-161/-281
hudBuilder.setCommanderSize 	561/561
hudBuilder.setZoomIcons 	0
hudBuilder.setCPFont 		"Fonts/commanderChatFontLocal_6.dif"
hudBuilder.setCPFontColor 	1 0.792 0.043 1

hudBuilder.createSplitNode		IngameHud MinSizeAlpha
hudBuilder.setNodeAlphaVariable		MenuBackgroundAlpha
hudBuilder.setNodeShowVariable 		MapMinSize 
rem hudBuilder.setNodeLogicShowVariable	NOT CommanderShow 1
hudBuilder.setNodeInTime 		0.3
hudBuilder.setNodeOutTime 		0
hudBuilder.addNodeAlphaShowEffect

hudBuilder.createSplitNode		IngameHud MinSizeMap
hudBuilder.setNodeShowVariable 		MapMinSize 
rem hudBuilder.setNodeLogicShowVariable	NOT CommanderShow 1
hudBuilder.setNodeInTime 		0.3
hudBuilder.setNodeOutTime 		0
hudBuilder.addNodeAlphaShowEffect

hudBuilder.createSplitNode		IngameHud TicketInfo 
hudBuilder.setNodeLogicShowVariable	NOT CommanderShow 1
hudBuilder.setNodeLogicShowVariable	NOT DemoShow 1
hudBuilder.setNodeInTime 		0
hudBuilder.setNodeOutTime 		0.3
hudBuilder.addNodeAlphaShowEffect

