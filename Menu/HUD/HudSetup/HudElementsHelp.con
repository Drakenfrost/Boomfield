hudBuilder.setTextNodeStyle		Fonts/helpMessageFontLocalBold_8.dif 2
hudBuilder.setTextNodeStringVariable 	IngameHelpString
hudBuilder.setNodeColor 		0.686 0.686 0.588 1
hudBuilder.setNodeShowVariable 		IngameHelpShow
hudBuilder.setNodeInTime 		0
hudBuilder.setNodeOutTime 		0.5
hudBuilder.addNodeAlphaShowEffect	

