rem ---------------------------------- Ingame help -------------------------------------

hudBuilder.createPictureNode 		IngameHud IngameHelpBg 260 23 335 87
hudBuilder.setPictureNodeTexture 	Ingame/Bars/helptextBg.tga
hudBuilder.setNodeColor 		1 1 1 0.82
hudBuilder.setNodeShowVariable 		IngameHelpShow
hudBuilder.setNodeInTime 		1
hudBuilder.setNodeOutTime 		0.5
hudBuilder.addNodeAlphaShowEffect

