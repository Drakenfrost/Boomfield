
rem ------------------------------------ Occupying Player Names -------------------------------------------------------

hudBuilder.createTransformNode 			IngameHud PlayerNames 150 477 180 60
hudBuilder.setNodeShowVariable 			VehiclePassengersShow
hudBuilder.setNodeInTime 			0.5
hudBuilder.setNodeOutTime 			0.5
hudBuilder.addNodeAlphaShowEffect	

rem ------------------------------------ Player 1 -------------------------------------------------------

hudBuilder.createTransformNode 			PlayerNames PlayerName1 0 70 180 14
hudBuilder.setNodeShowVariable			OccupyingPlayerName1Show
hudBuilder.setNodeInTime 			0.3
hudBuilder.setNodeOutTime 			0.3
hudBuilder.addNodeMoveShowEffect		1.57 14

hudBuilder.createPictureNode 			PlayerName1 Player1Background 0 0 180 14
hudBuilder.setPictureNodeTexture 		Ingame/GeneralIcons/full.tga
hudBuilder.setNodeColor 			0.268 0.294 0.243 1
hudBuilder.setNodeAlphaVariable 		BottomLeftVehicleFadedAlpha

hudBuilder.createTextNode			PlayerName1 Player1Name 2 -2 180 14
hudBuilder.setTextNodeStyle			Fonts/hudFontBold_9.dif 2
hudBuilder.setTextNodeStringVariable		OccupyingPlayerName1String
hudBuilder.setNodeRGBVariables			OccupyingPlayer1ColorRed OccupyingPlayer1ColorGreen OccupyingPlayer1ColorBlue
hudBuilder.setNodeAlphaVariable 		BottomLeftVehicleFadedAlpha

